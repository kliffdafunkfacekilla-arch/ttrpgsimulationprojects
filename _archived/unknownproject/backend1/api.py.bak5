class SettingsUpdateSchema(BaseModel):
    global_magic_flow: Optional[float] = None
    global_metabolism_rate: Optional[float] = None
    base_crop_yield: Optional[float] = None
    species_modifiers: Optional[dict] = None
    faction_modifiers: Optional[dict] = None

class HeroCreateSchema(BaseModel):
    name: str
    biological_type: str
    profession: str
    traits: str

class DirectiveUpdateSchema(BaseModel):
    directive: str

class TargetActionSchema(BaseModel):
    hero_id: str
    target_entity_id: str
    action_type: str

class EnvironmentActionSchema(BaseModel):
    hero_id: str
    task_type: str

