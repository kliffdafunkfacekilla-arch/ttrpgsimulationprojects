# Initialize the FastAPI Application
app = FastAPI(
    title="Ostraka World-Engine God Console API",
    description="High-performance simulation web service exposing GeoJSON macro world-states, ground-level entity telemetry, configuration parameters, and incident history.",
    version="1.2.0"
)

# Configure CORS Middleware to allow smooth integration with local React/Vite frontends
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

def get_db():
    """
    FastAPI dependency yielding a clean SQLAlchemy session context.
    Properly disposes of the connection upon request completion.
    """
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()

# Dynamic DB Migration on Startup
@app.on_event("startup")
def run_migrations():
    """
    Runs real-time database schema migrations on server startup.
    Ensures that PostgreSQL dynamically receives the new column witnessed_by_heroes on EventLog
    without needing full database wipes or complex migration frameworks.
    """
    from sqlalchemy import text
    db = SessionLocal()
    try:
        db.execute(text("ALTER TABLE event_logs ADD COLUMN IF NOT EXISTS witnessed_by_heroes JSONB DEFAULT '[]'::jsonb;"))
        db.commit()
        print("Dynamic DB Migration Successful: witnessed_by_heroes column verified.")
    except Exception as e:
        db.rollback()
        print(f"Warning: Dynamic DB Migration error: {e}")
    finally:
        db.close()

