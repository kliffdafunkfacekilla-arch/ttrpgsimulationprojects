@app.get("/api/settings")
def get_settings(db: Session = Depends(get_db)):
    """
    Retrieves the global simulation configuration settings.
    Guarantees existence of settings row 1.
    """
    try:
        settings = db.query(WorldSettings).filter_by(id=1).first()
        if not settings:
            settings = WorldSettings(
                id=1,
                global_magic_flow=1.0,
                global_metabolism_rate=1.0,
                base_crop_yield=1.0,
                species_modifiers={},
                faction_modifiers={}
            )
            db.add(settings)
            db.commit()
            db.refresh(settings)
        return settings
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/api/settings")
def update_settings(payload: SettingsUpdateSchema, db: Session = Depends(get_db)):
    """
    Updates the global simulation settings with partial overrides.
    Drives real-time physics tuning for magic, crops, and metabolic scales.
    """
    try:
        settings = db.query(WorldSettings).filter_by(id=1).first()
        if not settings:
            settings = WorldSettings(id=1)
            db.add(settings)
            
        if payload.global_magic_flow is not None:
            settings.global_magic_flow = payload.global_magic_flow
        if payload.global_metabolism_rate is not None:
            settings.global_metabolism_rate = payload.global_metabolism_rate
        if payload.base_crop_yield is not None:
            settings.base_crop_yield = payload.base_crop_yield
        if payload.species_modifiers is not None:
            settings.species_modifiers = payload.species_modifiers
        if payload.faction_modifiers is not None:
            settings.faction_modifiers = payload.faction_modifiers
            
        db.commit()
        db.refresh(settings)
        
        return {
            "success": True,
            "settings": settings
        }
    except Exception as e:
        db.rollback()
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/logs")
def get_logs(
    hex_id: Optional[str] = None,
    event_type: Optional[str] = None,
    tick_range: Optional[str] = None,
    db: Session = Depends(get_db)
):
    """
    Queries EventLog records for tactical events (SIEGE, FAMINE, STORM, REBELLION)
    to support story generation and history reconstruction in TTRPG worldbuilding.
    Filters optionally on target hex coordinates, event types, and tick spans.
    """
    try:
        query = db.query(EventLog)
        
        if hex_id:
            query = query.filter(EventLog.hex_id.ilike(f"%{hex_id}%"))
        if event_type:
            query = query.filter(EventLog.event_type.ilike(f"%{event_type}%"))
        if tick_range:
            try:
                parts = tick_range.split('-')
                if len(parts) == 2:
                    min_tick = int(parts[0])
                    max_tick = int(parts[1])
                    query = query.filter(EventLog.tick_count.between(min_tick, max_tick))
            except Exception:
                pass
                
        # Order by newest ticks and limit response size for maximum transmission speed
        logs = query.order_by(EventLog.tick_count.desc(), EventLog.id.desc()).limit(100).all()
        return logs
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

# =============================================================================
# HERO PROTOCOL & NOVELIST'S LOOM EXPORT ROUTING (PHASE 12 & 13)
# =============================================================================

@app.post("/api/hex/{hex_id}/hero")
def inject_custom_hero(hex_id: str, payload: HeroCreateSchema, db: Session = Depends(get_db)):
    """
    Injects a custom player-controlled character (Hero) into a hex.
    Heroes obey simulation metabolic rules but support manual pre-tick directives.
    Demographics counters are incremented accordingly to maintain world balance.
    """
    try:
        hex_state = db.query(HexState).filter(HexState.hex_id == hex_id).first()
        if not hex_state:
            raise HTTPException(status_code=404, detail="Selected hex coordinate could not be located.")
            
        if not isinstance(hex_state.local_entities, list):
            hex_state.local_entities = []
            
        # Generate clean unique ID
        import uuid
        entity_id = f"hero_{uuid.uuid4().hex[:8]}"
        
        # Determine stats and pools based on high fantasy RPG ruleset
        traits_dict = {
            "personality": payload.traits,
            "interest": "ADVENTURING"
        }
        rpg_stats = rpg_system.generate_stats(
            payload.biological_type,
            payload.profession,
            entity_type="HERO",
            traits=traits_dict
        )
        dynamic_pools = rpg_system.calculate_derived_pools(rpg_stats)
        
        # Build new player hero structure
        new_hero = {
            "entity_id": entity_id,
            "name": payload.name,
            "biological_type": payload.biological_type,
            "profession": payload.profession,
            "dna_profile": {
                "personality": payload.traits,
                "interest": "ADVENTURING",
                "fears": ["FAMINE", "DECAY"]
            },
            "metabolic_state": {
                "hunger_level": 0,
                "sanity_score": 1.0,
                "health": 100
            },
            "action_state": "RESTING",
            "is_hero": True,
            "active_directive": "AUTO",
            "default_behavior": "AUTO",
            "rpg_stats": rpg_stats,
            "dynamic_pools": dynamic_pools
        }
        
        hex_state.local_entities.append(new_hero)
        
        # Increment dynamic demographics counter
        species_plural = payload.biological_type + "s"
        if payload.biological_type.lower() == "mouse":
            species_plural = "Mice"
        elif payload.biological_type.lower() == "wolf":
            species_plural = "Wolves"
        elif payload.biological_type.lower() == "bear":
            species_plural = "Bears"
            
        hex_state.demographics[species_plural] = hex_state.demographics.get(species_plural, 0) + 1
        
        # Flag deep structures as mutated to notify SQLAlchemy tracker
        flag_modified(hex_state, "local_entities")
        flag_modified(hex_state, "demographics")
        
        db.commit()
        db.refresh(hex_state)
        
        return {
            "success": True,
            "hero": new_hero,
            "message": f"Hero '{payload.name}' successfully injected into hex '{hex_id}'."
        }
    except Exception as e:
        db.rollback()
        raise HTTPException(status_code=500, detail=str(e))

@app.put("/api/hex/{hex_id}/entity/{entity_id}/directive")
def update_hero_directive(hex_id: str, entity_id: str, payload: DirectiveUpdateSchema, db: Session = Depends(get_db)):
    """
    Overrides a custom Hero's schedule pre-tick action using a manual GM directive.
    Requires is_hero flag to prevent tampering with standard civilian NPCs.
    """
    try:
        hex_state = db.query(HexState).filter(HexState.hex_id == hex_id).first()
        if not hex_state:
            raise HTTPException(status_code=404, detail="Selected hex coordinate could not be located.")
            
        target_hero = None
        for ent in hex_state.local_entities:
            if ent.get("entity_id") == entity_id:
                target_hero = ent
                break
                
        if not target_hero:
            raise HTTPException(status_code=404, detail="Entity not found inside this hex.")
            
        if not target_hero.get("is_hero", False):
            raise HTTPException(status_code=400, detail="Directive overrides are only supported for player Hero entities.")
            
        target_hero["active_directive"] = payload.directive
        
        flag_modified(hex_state, "local_entities")
        db.commit()
        
        return {
            "success": True,
            "entity_id": entity_id,
            "active_directive": payload.directive,
            "message": f"Hero '{target_hero.get('name', 'Unknown')}' active directive updated to '{payload.directive}'."
        }
    except Exception as e:
        db.rollback()
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/export/chronicle")
def export_chronicle(
    hero_id: Optional[str] = None,
    tick_range: Optional[str] = None,
    db: Session = Depends(get_db)
):
    r"""
    Extracts chronological narrative EventLog listings and compiles them into a beautiful,
    Obsidian/Notion-ready Markdown export named C:/Users/krazy/Ostraka_Chronicle_[HeroName].md.
    Translates simulation clock ticks into readable Year/Day/Hour indices.
    """
    try:
        hero_name = "The Chronicles of Ostraka"
        hero_species = "N/A"
        hero_prof = "N/A"
        hero_traits = "N/A"
        
        if hero_id:
            target_hero = None
            hexes = db.query(HexState).all()
            for h in hexes:
                for ent in h.local_entities:
                    if ent.get("entity_id") == hero_id:
                        target_hero = ent
                        hero_name = ent.get("name", "Unknown Hero")
                        hero_species = ent.get("biological_type", "Unknown")
                        hero_prof = ent.get("profession", "Unknown")
                        hero_traits = ent.get("dna_profile", {}).get("personality", "Unknown")
                        break
                if target_hero:
                    break
                    
        query = db.query(EventLog)
        
        if tick_range:
            try:
                parts = tick_range.split('-')
                if len(parts) == 2:
                    min_tick = int(parts[0])
                    max_tick = int(parts[1])
                    query = query.filter(EventLog.tick_count.between(min_tick, max_tick))
            except Exception:
                pass
                
        logs = query.order_by(EventLog.tick_count.asc()).all()
        
        # Filter logs witnessed by this hero
        if hero_id:
            filtered_logs = []
            for log in logs:
                witnesses = log.witnessed_by_heroes or []
                if hero_id in witnesses:
                    filtered_logs.append(log)
            logs = filtered_logs
            
        # Build Obsidian-ready, high-fantasy styled Markdown output
        md_lines = []
        md_lines.append(f"# 📜 THE NOVELIST'S LOOM: CHRONICLE OF {hero_name.upper()}")
        md_lines.append("\n*Generated from the Ostraka World-Engine Simulation*\n")
        
        if hero_id:
            md_lines.append("## 👤 HERO PROFILE")
            md_lines.append(f"- **Name**: {hero_name}")
            md_lines.append(f"- **Species**: {hero_species}")
            md_lines.append(f"- **Profession**: {hero_prof}")
            md_lines.append(f"- **Personality Traits**: {hero_traits}")
            md_lines.append(f"- **Loom Identifier**: `{hero_id}`")
            md_lines.append("\n---\n")
            
        md_lines.append("## 📖 RECORDED HISTORICAL EVENTS")
        
        if not logs:
            md_lines.append("\n*No significant events have been witnessed by or recorded for this hero during this period.*")
        else:
            for log in logs:
                tick = log.tick_count
                hour = tick % 24
                day = (tick // 24) % 365 + 1
                year = tick // (24 * 365) + 1
                
                md_lines.append(f"\n### 🕒 Year {year}, Day {day} at {hour:02d}:00 (Tick {tick})")
                md_lines.append(f"- **Regional Territory**: `{log.hex_id}`")
                md_lines.append(f"- **Incident Classification**: `{log.event_type}` (Severity: {log.severity}/5)")
                md_lines.append(f"- **Chronicler Summary**: *{log.summary}*")
                
        md_lines.append("\n---\n*May your words shape the future of Ostraka.*")
        
        markdown_content = "\n".join(md_lines)
        return {
            "success": True,
            "markdown_content": markdown_content
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

# =============================================================================
# ACTION RESOLUTION ENGINE ENDPOINTS (PHASE 16)
# =============================================================================

@app.post("/api/hex/{hex_id}/action/target")
def execute_target_action(hex_id: str, payload: TargetActionSchema, db: Session = Depends(get_db)):
    """
    Executes a contested roll (e.g. ATTACK, DECEIVE) between a custom player Hero
    and an NPC resident inside the target hex coordinate.
    Updates stamina/focus and health/composure metrics.
    """
    try:
        hex_state = db.query(HexState).filter(HexState.hex_id == hex_id).first()
        if not hex_state:
            raise HTTPException(status_code=404, detail="Selected hex coordinate could not be located.")
            
        hero = None
        target = None
        for ent in hex_state.local_entities:
            if ent.get("entity_id") == payload.hero_id:
                hero = ent
            elif ent.get("entity_id") == payload.target_entity_id:
                target = ent
                
        if not hero:
            raise HTTPException(status_code=404, detail=f"Hero with ID '{payload.hero_id}' not found in hex.")
        if not target:
            raise HTTPException(status_code=404, detail=f"Target NPC with ID '{payload.target_entity_id}' not found in hex.")
            
        # Resolve Contested Roll
        result_text = action_engine.resolve_contested(hero, target, payload.action_type)
        
        # Flag mutated local entities column for SQLAlchemy commit tracking
        flag_modified(hex_state, "local_entities")
        db.commit()
        db.refresh(hex_state)
        
        # Retrieve target's updated copy from hex_state to ensure fresh state mapping back to React
        updated_target = None
        for ent in hex_state.local_entities:
            if ent.get("entity_id") == payload.target_entity_id:
                updated_target = ent
                break
                
        return {
            "success": True,
            "result_text": result_text,
            "hero_pools": hero["dynamic_pools"],
            "target": updated_target
        }
    except Exception as e:
        db.rollback()
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/api/hex/{hex_id}/action/environment")
def execute_environment_action(hex_id: str, payload: EnvironmentActionSchema, db: Session = Depends(get_db)):
    """
    Resolves a static environmental check (e.g. BREACH_GATES, SCAVENGE) for a Hero.
    Task DCs are dynamically adjusted based on the hex's regional physical variables.
    """
    try:
        hex_state = db.query(HexState).filter(HexState.hex_id == hex_id).first()
        if not hex_state:
            raise HTTPException(status_code=404, detail="Selected hex coordinate could not be located.")
            
        hero = None
        for ent in hex_state.local_entities:
            if ent.get("entity_id") == payload.hero_id:
                hero = ent
                break
                
        if not hero:
            raise HTTPException(status_code=404, detail=f"Hero with ID '{payload.hero_id}' not found in hex.")
            
        # Determine and scale task parameters dynamically
        task_type_upper = payload.task_type.upper()
        if task_type_upper == "BREACH_GATES":
            stat_primary = "might"
            stat_secondary = "logic"
            
            # Base Might DC 6, logic DC 5. Scaled upward by regional physical elevation index
            dc_primary = max(1, min(9, 6 + int((hex_state.elevation or 0.0) * 3)))
            dc_secondary = max(1, min(9, 5 + int((hex_state.aetheric_leak_rate or 0.0) * 3)))
        elif task_type_upper == "SCAVENGE":
            stat_primary = "awareness"
            stat_secondary = "finesse"
            
            # Base Awareness DC 4, Finesse DC 5. Scaled by extreme cold temperatures and dampness
            dc_primary = 4
            if (hex_state.temperature or 0) < 0:
                dc_primary += 2
                
            dc_secondary = 5
            if (hex_state.moisture or 0) > 0.6:
                dc_secondary += 1
                
            dc_primary = max(1, min(9, dc_primary))
            dc_secondary = max(1, min(9, dc_secondary))
        else:
            raise HTTPException(status_code=400, detail=f"Unsupported environmental task type: '{payload.task_type}'")
            
        # Resolve task check via resolution math module
        success, result_text = action_engine.resolve_static_task(
            hero, dc_primary, dc_secondary, stat_primary, stat_secondary
        )
        
        # Save modifications back to DB
        flag_modified(hex_state, "local_entities")
        db.commit()
        db.refresh(hex_state)
        
        return {
            "success": success,
            "result_text": result_text,
            "hero_pools": hero["dynamic_pools"],
            "dc_primary": dc_primary,
            "dc_secondary": dc_secondary
        }
    except Exception as e:
        db.rollback()
        raise HTTPException(status_code=500, detail=str(e))

if __name__ == "__main__":
    # Run the Uvicorn application on port 8000 directly when invoked
    uvicorn.run(app, host="0.0.0.0", port=8000)
