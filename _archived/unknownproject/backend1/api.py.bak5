@app.get("/api/world")
def get_world(db: Session = Depends(get_db)):
    """
    Retrieves all HexState records and maps them into a tiled pointy-topped GeoJSON 
    FeatureCollection for visual rendering on React map layers.
    Excludes granular local_entities payload to maximize transmission speeds.
    """
    try:
        hexes = db.query(HexState).order_by(HexState.hex_id).all()
        features = []
        
        # Spacing and trigonometry constants for perfect pointy-topped hex grids
        R = 0.010  # Outer radius (controls size of hexes in coordinates space)
        angles = [math.radians(a) for a in [30, 90, 150, 210, 270, 330, 30]]
        
        for h in hexes:
            # Reconstruct grid coordinate position (x=col, y=row) from hex_id index
            # Check if preserved Azgaar geometry exists in urban_meters
            azgaar_geom = h.urban_meters.get("azgaar_geometry") if h.urban_meters else None
            
            if azgaar_geom:
                # Use preserved coordinates directly!
                coordinates = azgaar_geom
            else:
                try:
                    idx = int(h.hex_id.split('_')[1])
                    col = (idx - 1) % 50
                    row = (idx - 1) // 50
                except Exception:
                    col, row = 0, 0
                    
                # Pointy-topped hex offset grid geometry center calculation
                cx = col * 0.015
                cy = row * 0.01732 + (col % 2) * 0.00866
                
                # Generate the six vertices forming the hex polygon boundary
                coordinates = [[
                    round(cx + R * math.cos(a), 6),
                    round(cy + R * math.sin(a), 6)
                ] for a in angles]
            
            feature = {
                "type": "Feature",
                "id": h.hex_id,
                "geometry": {
                    "type": "Polygon",
                    "coordinates": coordinates
                },
                "properties": {
                    "hex_id": h.hex_id,
                    "tick_count": h.tick_count,
                    "faction_id": h.faction_id,
                    "temperature": h.temperature,
                    "moisture": h.moisture,
                    "elevation": h.elevation,
                    "macro_stability": h.macro_stability,
                    "aetheric_leak_rate": h.aetheric_leak_rate,
                    "urban_meters": h.urban_meters,
                    "stockpiles": h.stockpiles,
                    "demographics": h.demographics,
                    # Expose Layer 3 Grand Strategy parameters
                    "military_engagements": h.military_engagements,
                    "covert_networks": h.covert_networks
                }
            }
            features.append(feature)
            
        return {
            "type": "FeatureCollection",
            "features": features
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/hex/{hex_id}")
def get_hex_inspect(hex_id: str, db: Session = Depends(get_db)):
    """
    Retrieves the complete state of a single hex cell.
    Returns full ground-level 'local_entities' telemetry including personality DNA,
    hunger, sanity indices, and active schedule actions.
    """
    hex_state = db.query(HexState).filter(HexState.hex_id == hex_id).first()
    if not hex_state:
        raise HTTPException(
            status_code=404, 
            detail=f"HexState with identifier '{hex_id}' could not be located."
        )
        
    return {
        "hex_id": hex_state.hex_id,
        "tick_count": hex_state.tick_count,
        "faction_id": hex_state.faction_id,
        "elevation": hex_state.elevation,
        "moisture": hex_state.moisture,
        "temperature": hex_state.temperature,
        "macro_stability": hex_state.macro_stability,
        "aetheric_leak_rate": hex_state.aetheric_leak_rate,
        "urban_meters": hex_state.urban_meters,
        "stockpiles": hex_state.stockpiles,
        "demographics": hex_state.demographics,
        "military_engagements": hex_state.military_engagements,
        "covert_networks": hex_state.covert_networks,
        "local_entities": hex_state.local_entities
    }

@app.post("/api/hex/{hex_id}/entity/{entity_id}/journal")
def generate_entity_journal(hex_id: str, entity_id: str, db: Session = Depends(get_db)):
    """
    Exposes a dynamic in-character journal generator using Ollama local Llama3 LLM.
    Collects ground-level DNA profile metrics, daily metabolism rates, local factions,
    and climate values, and prompts the local generative LLM.
    Contains robust deterministic fallback generation if the Ollama server is offline.
    """
    hex_state = db.query(HexState).filter(HexState.hex_id == hex_id).first()
    if not hex_state:
        raise HTTPException(status_code=404, detail="Selected hex coordinate could not be located.")
        
    # Search local entities list for matching ID
    target_entity = None
    for ent in hex_state.local_entities:
        if ent.get("entity_id") == entity_id:
            target_entity = ent
            break
            
    if not target_entity:
        raise HTTPException(status_code=404, detail="Tactical citizen entity could not be found inside this hex.")
        
    # Gather granular context variables
    biological_type = target_entity.get("biological_type", "Mouse")
    profession = target_entity.get("profession", "Farmer")
    dna = target_entity.get("dna_profile", {})
    metabolic = target_entity.get("metabolic_state", {})
    
    traits = dna.get("personality", "Quiet")
    fears = ", ".join(dna.get("fears", ["Famine"]))
    interest = dna.get("interest", "Survival")
    
    hunger = metabolic.get("hunger_level", 0)
    sanity = metabolic.get("sanity_score", 1.0)
    
    faction_owned = hex_state.faction_id or "Neutral Wilderness"
    temp = hex_state.temperature
    
    # Construct concise, high-context instruction prompt
    constructed_prompt = (
        f"You are a {biological_type} working as a {profession} in the fantasy realm of Ostraka. "
        f"Your personality is {traits}. You deeply fear {fears} and are highly interested in {interest}. "
        f"Currently, your metabolic hunger is {hunger}/100 and your sanity score is {sanity}/1.0. "
        f"You reside in a regional territory owned by {faction_owned}. The local weather temperature is {temp}°C. "
        f"Write a raw, first-person, exactly 3-sentence journal entry about your current life right now. "
        f"Do not include any greetings, labels, notes, or pleasantries. Write in character immediately."
    )
    
    # Ollama integration call
    try:
        ollama_url = "http://localhost:11434/api/generate"
        payload = {
            "model": "llama3",
            "prompt": constructed_prompt,
            "stream": False
        }
        res = requests.post(ollama_url, json=payload, timeout=4.0)
        
        if res.status_code == 200:
            text = res.json().get("response", "").strip()
            if not text:
                raise ValueError("Blank response from Ollama")
        else:
            raise ConnectionError("Ollama returned unhealthy status")
            
    except Exception as e:
        # Fallback templates
        fallback_templates = [
            f"The shadow of {faction_owned} looms heavily over my daily shifts. As a {traits} {biological_type}, my thoughts constantly drift towards {interest}. With hunger gnawing at {hunger}% and sanity draining, I pray the cold temperature of {temp}°C does not break my resolve.",
            f"Working as a local {profession} is all I have left in this wilderness. Fear of {fears} keeps me awake during the dark resting hours. My hands are worn from the grind, but Ostraka demands diligence if I want to survive another tick.",
            f"My basic instincts as a {biological_type} warn me of incoming structural decay. The stockpiles are running thin, and my sanity score of {sanity:.2f} reflects our isolation. I must remain focused on my duties today."
        ]
        text = random.choice(fallback_templates)
        
    return {
        "success": True,
        "journal_entry": text
    }

@app.post("/api/simulate/tick")
def trigger_simulation_tick(db: Session = Depends(get_db)):
    """
    Triggers a single-step simulation hourly tick transformation across all hexes.
    Evaluates demographics consumption, logistics production, covert espionage operations,
    military siege resolution and conquests, and metabolic schedules.
    Persists deep mutations back to PostgreSQL and returns new clock telemetry.
    """
    try:
        # 1. Fetch adjustable simulation settings
        settings = db.query(WorldSettings).filter_by(id=1).first()
        if not settings:
            settings = WorldSettings(
                id=1,
                global_magic_flow=1.0,
                global_metabolism_rate=1.0,
                base_crop_yield=1.0,
                species_modifiers={},
                faction_modifiers={}
            )
            db.add(settings)
            db.commit()
            settings = db.query(WorldSettings).filter_by(id=1).first()

        # 2. Instantiate adjustable logger
        logger_inst = SimulationLogger()

        # 3. Process each hex cell
        hexes = db.query(HexState).all()
        if not hexes:
            raise HTTPException(
                status_code=404, 
                detail="No hex state database records found. Please initialize the database with world generator first."
            )
            
        total_entities_processed = 0
        for h in hexes:
            processed_count = process_tick(
                h, 
                settings=settings, 
                session=db, 
                logger=logger_inst
            )
            total_entities_processed += processed_count
            
            # Flag nested JSONB columns to notify SQLAlchemy tracker of deep dict changes
            flag_modified(h, "stockpiles")
            flag_modified(h, "urban_meters")
            flag_modified(h, "demographics")
            flag_modified(h, "military_engagements")
            flag_modified(h, "covert_networks")
            flag_modified(h, "local_entities")
            flag_modified(h, "local_scars")
            
        db.commit()
        
        # Extrapolate new simulation clock status
        new_tick = hexes[0].tick_count
        hour = new_tick % 24
        
        return {
            "success": True,
            "tick_count": new_tick,
            "in_game_hour": f"{hour:02d}:00",
            "processed_entities": total_entities_processed,
            "message": f"Tick [{new_tick}] completed. Advanced clock to Hour [{hour:02d}:00]."
        }
    except Exception as e:
        db.rollback()
        raise HTTPException(status_code=500, detail=str(e))

